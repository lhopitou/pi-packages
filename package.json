{
  "name": "pi-packages",
  "version": "1.0.0",
  "description": "Personal pi extensions, agents, and tools",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/gondolin": "0.12.0",
    "diff": "^8.0.2",
    "file-type": "^21.3.0",
    "p-limit": "^6.1.0",
    "tree-sitter-wasms": "^0.1.13",
    "turndown": "^7.2.0",
    "unpdf": "^1.6.2",
    "web-tree-sitter": "^0.20.8",
    "xxhash-wasm": "^1.1.0"
  },
  "devDependencies": {
    "@types/turndown": "^5.0.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./extensions/*.ts",
      "./extensions/*/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": ["./prompts/"]
  }
}
